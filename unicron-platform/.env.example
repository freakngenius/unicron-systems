# Operator UI env. Copy to `.env.local` and fill in from the Supabase dashboard
# (Settings → API). `.env.local` is gitignored.

# Supabase project URL (e.g. https://anfihcusvekpovcchpoh.supabase.co).
VITE_SUPABASE_URL=

# Supabase anon (publishable) key. Browser-safe — RLS enforces row visibility.
# NEVER paste the service-role key here; that key must stay server-side only.
VITE_SUPABASE_ANON_KEY=

# When "true", the app requires a magic-link Supabase session before rendering.
# Leave unset (or "false") for local development.
VITE_AUTH_REQUIRED=false

# Feature flag: swap the mocked Architect Inbox decomposition flow for the
# real Stream D Architect API once the contract ships.
VITE_ARCHITECT_API_ENABLED=false

# Feature flag: swap the mocked Add Source / Source Onboarder flow for the
# real Stream E onboarding API once the contract ships.
VITE_SOURCE_ONBOARDER_ENABLED=false
