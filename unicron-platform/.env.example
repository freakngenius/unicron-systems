# Operator UI env. Copy to `.env.local` and fill in from the Supabase dashboard
# (Settings → API). `.env.local` is gitignored.

# Supabase project URL (e.g. https://anfihcusvekpovcchpoh.supabase.co).
VITE_SUPABASE_URL=

# Supabase anon (publishable) key. Browser-safe — RLS enforces row visibility.
# NEVER paste the service-role key here; that key must stay server-side only.
VITE_SUPABASE_ANON_KEY=

# When "true", the app requires a magic-link Supabase session before rendering.
# Leave unset (or "false") for local development.
VITE_AUTH_REQUIRED=false

# Pathfinder cost-summary endpoint URL — drives the visualizer HUD's
# `cost.per.report` cell. Cross-origin fetch; no auth (the endpoint is
# public-read). Leave unset to keep the cost cell at $0.000.
# Example: https://unicron-pathfinder.vercel.app/pathfinder/api/cost-summary
VITE_COST_SUMMARY_URL=

# ── Atrium (internal cockpit) ────────────────────────────────────────────────
# Enable the Atrium shell at atrium.unicron.systems. Must be "true" in
# production Vercel env or the app falls through to a "Not found" shell.
VITE_ATRIUM_ENABLED=false

# Comma-separated list of emails allowed into Atrium after auth.
# Empty = no allowlist enforced (all authenticated users may enter).
# Example: kyle@unicron.systems,keenan@unicron.systems
VITE_ATRIUM_EMAIL_ALLOWLIST=

# ── Architect API (Stream D) ──────────────────────────────────────────────────
# Feature flag: swap the mocked Architect Inbox decomposition flow for the
# real Stream D Architect API once the contract ships.
VITE_ARCHITECT_API_ENABLED=false
# Stream D's Architect API base URL. Required when the flag above is true.
# Example: https://unicron-architect.vercel.app
VITE_ARCHITECT_API_URL=

# Feature flag: swap the mocked Add Source / Source Onboarder flow for the
# real Stream E onboarding API once the contract ships.
VITE_SOURCE_ONBOARDER_ENABLED=false
# Stream E's Source Onboarder API base URL. Required when the flag is true.
# Example: https://unicron-source-onboarder.vercel.app
VITE_SOURCE_ONBOARDER_URL=

# ── Notion integrations (server-only) ────────────────────────────────────────
# Server-side Notion API token used by api/* routes (e.g. accounts query,
# kanban sync). NEVER expose to the browser — no VITE_ prefix.
NOTION_TOKEN=
# Notion database IDs. Same pattern as NOTION_DB_*_KANBAN.
NOTION_DB_ACCOUNTS=350785c6-7e72-8039-b4ee-e158a72bf35c
NOTION_DB_INTERNAL_KANBAN=
NOTION_DB_METACRON_KANBAN=
NOTION_DB_PATHFINDER_KANBAN=
