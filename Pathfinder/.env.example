# Pathfinder env (copy to .env.local)

# Supabase — uses the existing `unicron-systems` project; all Pathfinder tables in `pathfinder` schema
NEXT_PUBLIC_SUPABASE_URL=https://anfihcusvekpovcchpoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (free tier is fine; if missing, app falls back to a stylized SVG NA outline)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Anthropic (used by streaming-rationale fallback API route AND the Verifier cron at /api/cron/verifier)
ANTHROPIC_API_KEY=

# Basic auth gate
BASIC_AUTH_USER=zedcor
BASIC_AUTH_PASS=

# Verifier cron secret. Vercel sends `Authorization: Bearer ${CRON_SECRET}` on every cron request
# when this env var is configured in Project Settings → Environment Variables.
# Generate a random 32-byte hex string: `openssl rand -hex 32`
# Set in Vercel for production; locally you can also pass `?secret=<value>` for debugging.
CRON_SECRET=
