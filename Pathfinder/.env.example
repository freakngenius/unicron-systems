# Pathfinder env (copy to .env.local)

# Supabase — uses the existing `unicron-systems` project; all Pathfinder tables in `pathfinder` schema
NEXT_PUBLIC_SUPABASE_URL=https://anfihcusvekpovcchpoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps. Required for the dashboard map; without it the map tiles fail to load.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic (Ranker rationale, Outreach Drafter, Verifier cron — anything claude-*).
# Routed through lib/llm/run.ts (Phase 1 G1 LLM gateway); writes to pathfinder.llm_calls.
ANTHROPIC_API_KEY=

# Perplexity Sonar (Intelligence Chat panel, future Adjacent / Competitive agents).
# Routed through lib/llm/run.ts; writes to pathfinder.llm_calls.
PERPLEXITY_API_KEY=

# Optional model overrides (defaults: claude-sonnet-4-6, sonar). Useful when
# A/B testing models or pinning a specific snapshot during eval runs.
PF_RATIONALE_MODEL=claude-sonnet-4-6
PF_OUTREACH_MODEL=claude-sonnet-4-6
PF_SONAR_MODEL=sonar

# Upstash Redis cache for the LLM gateway. Optional — when unset the gateway
# is a no-op for caching (every call hits the provider). When set, deterministic
# agents cache responses by hash(prompt + input).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Helicone observability. Optional — when set, the LLM gateway routes Anthropic
# (via baseURL override) and Perplexity (via gateway endpoint) through Helicone
# for trace inspection. When unset, calls go direct to the providers.
HELICONE_API_KEY=

# Axiom structured logging. Optional — when both set, lib/observability/axiom
# fires events to the configured dataset for cross-service log aggregation.
# Vercel function console.* output also lands in Axiom via the native
# Vercel-Axiom integration if configured in Vercel dashboard.
AXIOM_TOKEN=
AXIOM_DATASET=

# Inngest agent-pipeline event bus. Required for production. Get from the
# Inngest dashboard at https://app.inngest.com after creating the `pathfinder`
# app. SIGNING_KEY validates incoming function-discovery + event-dispatch
# requests; EVENT_KEY authenticates outbound inngest.send() calls.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM cost alert threshold (USD/day). Default: 50. The /api/cron/cost-alert
# handler fires at 13:00 UTC daily; if pathfinder.llm_calls.cost_usd over the
# trailing 24h exceeds this, posts to SLACK_WEBHOOK_URL + emails
# BRIEFING_ORG_EMAIL.
COST_ALERT_THRESHOLD_USD=50

# SAM.gov ingestor key. Without this, the SAM.gov source returns no events.
# Sign up at https://sam.gov/api/registration
SAM_GOV_API_KEY=

# Resend (briefing + alert email delivery). Domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated list of emails the Friday briefing is delivered to.
BRIEFING_ORG_EMAIL=

# Comma-separated list of emails granted operator UI access (cost panel,
# debug toggles, internal-only routes). Read by /api/me.
OPERATOR_EMAILS=

# Basic auth gate
BASIC_AUTH_USER=zedcor
BASIC_AUTH_PASS=

# Verifier cron secret. Vercel sends `Authorization: Bearer ${CRON_SECRET}` on every cron request
# when this env var is configured in Project Settings → Environment Variables.
# Generate a random 32-byte hex string: `openssl rand -hex 32`
# Set in Vercel for production; locally you can also pass `?secret=<value>` for debugging.
# Also gates the internal-only POST /api/hubspot/push-deal endpoint.
CRON_SECRET=

# HubSpot integration (P0-03 — bidirectional sync). Setup walkthrough:
# Pathfinder/docs/HUBSPOT-SANDBOX-SETUP.md.
# HubSpot Private App access token. Bearer credential for outbound API calls.
HUBSPOT_API_KEY=
# HubSpot Private App secret. Used to verify webhook signatures (HMAC-SHA256).
HUBSPOT_APP_SECRET=
# Deal pipeline + stage IDs (portal-specific opaque strings). Discover with:
#   curl -H "Authorization: Bearer $HUBSPOT_API_KEY" https://api.hubapi.com/crm/v3/pipelines/deals
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_STAGE_ACCEPTED_ID=
HUBSPOT_STAGE_MEETING_ID=
HUBSPOT_STAGE_PROPOSAL_ID=
HUBSPOT_STAGE_WON_ID=
HUBSPOT_STAGE_LOST_ID=
# Optional: when Pathfinder is behind a proxy, the public URL HubSpot signed
# differs from req.url. Set this to the URL HubSpot was configured with.
HUBSPOT_WEBHOOK_PUBLIC_URL=

# Optional: dashboard deep-link base URL embedded in HubSpot deal notes.
# Also used in /api/me; falls back to a relative path when missing.
NEXT_PUBLIC_BASE_URL=
PATHFINDER_API_BASE=
PATHFINDER_PUBLIC_URL=

# Send-from-Pathfinder OAuth (Stream B Gate B2). Operator connects their
# own Gmail / Outlook account; tokens are stored in
# pathfinder.email_integrations (service-role only). When client IDs are
# unset, /api/email/oauth/start returns 503 — the composer surfaces a
# "not configured" hint to the operator.
#
# Gmail (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0):
#   Authorized redirect URIs must include
#   https://www.unicron.systems/pathfinder/api/email/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Outlook (Microsoft Entra ID → App registrations):
#   Redirect URI (Web): https://www.unicron.systems/pathfinder/api/email/oauth/callback
#   API permissions: Microsoft Graph Mail.Send (delegated), offline_access,
#                    User.Read (delegated). Grant admin consent for the tenant.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# Reply detection (Stream B Gate B3). EMAIL_GRAPH_CLIENT_STATE is the
# shared secret echoed back from Microsoft Graph subscription pushes;
# set it when registering the subscription via Graph and re-use here.
# EMAIL_WEBHOOK_DEFAULT_OPERATOR is the operator whose stored access_token
# the Gmail Pub/Sub + Outlook webhook handlers use to fetch message
# metadata (single-tenant, Zedcor-only for v1).
EMAIL_GRAPH_CLIENT_STATE=
EMAIL_WEBHOOK_DEFAULT_OPERATOR=

# Slack bot (P0-04). Step-by-step setup on api.slack.com lives in
# Pathfinder/docs/SLACK-APP-SETUP.md.
# OAuth client credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Signing secret — verifies the HMAC on every Events API + Interactivity payload.
SLACK_SIGNING_SECRET=
# Optional dev fallback. Production reads bot tokens from pathfinder.slack_workspaces.bot_token.
SLACK_BOT_TOKEN=
# Legacy webhook URL — kept as a fallback for the briefing flow when no
# slack_workspaces row exists for the recipient.
SLACK_WEBHOOK_URL=

# Connector framework (C-1A schema + C-1B Slack OAuth + send).
# CONNECTOR_TOKEN_KEY is the symmetric key passed to pgcrypto's
# pgp_sym_encrypt for connector_tokens at-rest encryption. 32+ bytes
# of strong entropy. Rotation is per-tenant via the token_version column.
CONNECTOR_TOKEN_KEY=
# Optional separate secret for OAuth state-token signing. Falls back to
# CRON_SECRET when unset (same convention as lib/slack/install.ts).
CONNECTOR_STATE_SECRET=
